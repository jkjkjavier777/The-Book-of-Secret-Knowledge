{
  "name": "the-book-of-secret-knowledge-bot",
  "version": "1.0.0",
  "description": "Chatbot project combining local terminal chat and Messenger/Instagram webhook integration.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node scripts/bot.js --server",
    "list": "node scripts/bot.js --list",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest test/unit/",
    "test:integration": "jest test/integration/",
    "test:e2e": "jest test/e2e/",
    "test:safety": "jest test/safety/",
    "test:all": "jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "fs": "^0.0.1-security",
    "node-fetch": "^2.7.0",
    "openai": "^6.48.0",
    "path": "^0.12.7",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^2.0.16"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "core/**/*.js",
      "scripts/**/*.js",
      "server/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "author": "Joi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkjkjavier777/The-Book-of-Secret-Knowledge.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jkjkjavier777/The-Book-of-Secret-Knowledge/issues"
  },
  "homepage": "https://github.com/jkjkjavier777/The-Book-of-Secret-Knowledge#readme"
}
